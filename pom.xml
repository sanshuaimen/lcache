<?xml version="1.0" encoding="UTF-8"?>
<!--
  lcache-parent：本地缓存中间件多模块聚合根。

  模块一览：
    modules/sp-size         嵌入式 SP 无锁 size 算法（vendor 子集，包名 algorithms.*/measurements.* 保持不变）
    modules/lcache-core     缓存语义层主体（纯 JDK，零三方运行依赖）
    modules/lcache-benchmark JMH 基准（引擎对比 / 命中率 / 规模扩展）
    modules/lcache-demo     后端请求场景演示（worker 线程模拟请求）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.lcache</groupId>
    <artifactId>lcache-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>lcache-parent</name>
    <description>无锁哈希之上的本地缓存语义中间件（多模块聚合）</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.0</junit.version>
        <jmh.version>1.37</jmh.version>
    </properties>

    <modules>
        <module>modules/sp-size</module>
        <module>modules/lcache-core</module>
        <module>modules/lcache-benchmark</module>
        <module>modules/lcache-demo</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>io.lcache</groupId>
                <artifactId>sp-size</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.lcache</groupId>
                <artifactId>lcache-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 测试：JUnit 5 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- 基准：JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
